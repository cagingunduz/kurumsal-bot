# exitpump_bot -- ortam değişkenleri örneği
#
# Backtest ve paper trading için HİÇBİRİ ZORUNLU DEĞİL -- OKX'in market data
# endpoint'leri (candles, books, trades, open-interest) public'tir, key istemez.
# Bu değişkenler sadece ileride execution.mode config.yaml'da "paper" dışına
# çıkarsa (canlı/testnet emir göndermek için) kullanılır -- ki bu proje şu an
# bunu implemente ETMEMİŞTİR (bkz. README "Canlıya geçiş" bölümü).
#
# Railway'de: Project -> Variables sekmesinden bu değerleri gir, bu dosyayı
# (.env) repo'ya ASLA commitleme (zaten .gitignore'da).

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Alternatif olarak Binance'e dönersen (config.yaml: exchange.provider=binance):
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Opsiyonel: Telegram bildirimleri (config.yaml: notify.telegram.enabled=true ise)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
